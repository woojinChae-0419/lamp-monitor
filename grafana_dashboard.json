{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "title": "LAMP 센서 실시간 모니터링",
  "uid": "lamp-sensor-001",
  "version": 1,
  "refresh": "2s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "title": "온도 (°C)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0, "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 20 },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 38 }
            ]
          }
        }
      },
      "targets": [{
        "rawSql": "SELECT created_at AS time, temperature AS value FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
        "format": "time_series",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "습도 (%)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green",  "value": 40 },
              { "color": "yellow", "value": 75 },
              { "color": "red",    "value": 85 }
            ]
          }
        }
      },
      "targets": [{
        "rawSql": "SELECT created_at AS time, humidity AS value FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
        "format": "time_series",
        "refId": "B"
      }]
    },
    {
      "id": 3,
      "title": "기압 (hPa)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurebar",
          "min": 950, "max": 1050,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 980 },
              { "color": "red",   "value": 1025 }
            ]
          }
        }
      },
      "targets": [{
        "rawSql": "SELECT created_at AS time, pressure AS value FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
        "format": "time_series",
        "refId": "C"
      }]
    },
    {
      "id": 4,
      "title": "CO2 (ppm)",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "min": 0, "max": 2000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 700 },
              { "color": "red",    "value": 1200 }
            ]
          }
        }
      },
      "targets": [{
        "rawSql": "SELECT created_at AS time, co2 AS value FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
        "format": "time_series",
        "refId": "D"
      }]
    },
    {
      "id": 5,
      "title": "센서 데이터 추이",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "rawSql": "SELECT created_at AS time, temperature FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
          "format": "time_series",
          "refId": "A"
        },
        {
          "rawSql": "SELECT created_at AS time, humidity FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
          "format": "time_series",
          "refId": "B"
        },
        {
          "rawSql": "SELECT created_at AS time, co2/10 AS co2_scaled FROM sensor_data WHERE $__timeFilter(created_at) ORDER BY created_at",
          "format": "time_series",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "최근 센서 데이터",
      "type": "table",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "options": { "sortBy": [{ "displayName": "created_at", "desc": true }] },
      "targets": [{
        "rawSql": "SELECT id, temperature, humidity, pressure, co2, created_at FROM sensor_data ORDER BY id DESC LIMIT 15",
        "format": "table",
        "refId": "A"
      }]
    }
  ]
}
