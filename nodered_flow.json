[
  {
    "id": "tab_sensor",
    "type": "tab",
    "label": "센서 실시간 모니터링",
    "disabled": false
  },
  {
    "id": "inject_timer",
    "type": "inject",
    "z": "tab_sensor",
    "name": "2초마다 폴링",
    "props": [{"p": "payload"}],
    "repeat": "2",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 120,
    "wires": [["query_mysql"]]
  },
  {
    "id": "query_mysql",
    "type": "mysql",
    "z": "tab_sensor",
    "mydbConfig": "mysql_config",
    "name": "최신 20건 조회",
    "query": "SELECT * FROM sensor_data ORDER BY id DESC LIMIT 20",
    "querytype": "str",
    "x": 340,
    "y": 120,
    "wires": [["split_rows"]]
  },
  {
    "id": "split_rows",
    "type": "split",
    "z": "tab_sensor",
    "name": "행 분리",
    "splt": "\\n",
    "spltType": "str",
    "x": 540,
    "y": 120,
    "wires": [["extract_fields"]]
  },
  {
    "id": "extract_fields",
    "type": "function",
    "z": "tab_sensor",
    "name": "필드 추출",
    "func": "var row = msg.payload;\nmsg.temperature = row.temperature;\nmsg.humidity    = row.humidity;\nmsg.pressure    = row.pressure;\nmsg.co2         = row.co2;\nreturn msg;",
    "outputs": 1,
    "x": 740,
    "y": 120,
    "wires": [["gauge_temp","gauge_hum","gauge_pres","gauge_co2","chart_temp"]]
  },
  {
    "id": "gauge_temp",
    "type": "ui_gauge",
    "z": "tab_sensor",
    "name": "온도",
    "group": "group_main",
    "order": 1,
    "label": "온도",
    "format": "{{msg.temperature}} °C",
    "min": 0,
    "max": 50,
    "seg1": 25,
    "seg2": 35,
    "x": 980,
    "y": 60,
    "wires": []
  },
  {
    "id": "gauge_hum",
    "type": "ui_gauge",
    "z": "tab_sensor",
    "name": "습도",
    "group": "group_main",
    "order": 2,
    "label": "습도",
    "format": "{{msg.humidity}} %",
    "min": 0,
    "max": 100,
    "seg1": 40,
    "seg2": 70,
    "x": 980,
    "y": 120,
    "wires": []
  },
  {
    "id": "gauge_pres",
    "type": "ui_gauge",
    "z": "tab_sensor",
    "name": "기압",
    "group": "group_main",
    "order": 3,
    "label": "기압",
    "format": "{{msg.pressure}} hPa",
    "min": 950,
    "max": 1050,
    "seg1": 980,
    "seg2": 1020,
    "x": 980,
    "y": 180,
    "wires": []
  },
  {
    "id": "gauge_co2",
    "type": "ui_gauge",
    "z": "tab_sensor",
    "name": "CO2",
    "group": "group_main",
    "order": 4,
    "label": "CO2",
    "format": "{{msg.co2}} ppm",
    "min": 0,
    "max": 2000,
    "seg1": 700,
    "seg2": 1200,
    "x": 980,
    "y": 240,
    "wires": []
  },
  {
    "id": "chart_temp",
    "type": "ui_chart",
    "z": "tab_sensor",
    "name": "온도 차트",
    "group": "group_main",
    "order": 5,
    "label": "온도 추이 (°C)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "",
    "dot": false,
    "ymin": "0",
    "ymax": "50",
    "x": 980,
    "y": 300,
    "wires": [[],[]]
  },
  {
    "id": "mysql_config",
    "type": "MySQLdatabase",
    "name": "sensordb",
    "host": "127.0.0.1",
    "port": "3306",
    "db": "sensordb",
    "tz": "",
    "charset": "UTF8MB4_GENERAL_CI"
  },
  {
    "id": "group_main",
    "type": "ui_group",
    "name": "센서 데이터",
    "tab": "ui_tab_sensor",
    "order": 1,
    "disp": true,
    "width": "24"
  },
  {
    "id": "ui_tab_sensor",
    "type": "ui_tab",
    "name": "실시간 센서",
    "icon": "dashboard",
    "order": 1
  }
]
